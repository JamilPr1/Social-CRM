# App URL — set to your Vercel URL or custom domain in production
# NEXT_PUBLIC_APP_URL=https://social-crm-five.vercel.app
# NEXT_PUBLIC_APP_URL=https://crm.arfadevelopers.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_SECRET=generate-a-long-random-string-here
# Legal pages (used in Privacy Policy, Terms, Meta App settings)
LEGAL_APP_NAME=Arfa CRM
LEGAL_COMPANY_NAME=Arfa Developers
LEGAL_CONTACT_EMAIL=aarfa.developers@gmail.com

# Admin account & outbound email (invites sent from this address)
ADMIN_EMAIL=aarfa.developers@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=aarfa.developers@gmail.com
SMTP_PASS=your-gmail-app-password

# Database — Neon PostgreSQL (use your connection string from neon.tech dashboard)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"# Meta / Facebook App credentials
# Create app at https://developers.facebook.com/apps/
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
# Production: https://social-crm-five.vercel.app/api/meta/callback
# Or custom domain: https://crm.arfadevelopers.com/api/meta/callback
# Facebook Login for Business Configuration ID
# Get from: App Dashboard → Facebook Login for Business → Configurations → Create
META_LOGIN_CONFIG_ID=your_configuration_id_here

# Token encryption key (32+ chars)
TOKEN_ENCRYPTION_KEY=change-this-to-a-32-character-secret

# ─── LinkedIn (from linkedin-automation-suite) ───
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback
# Production: https://social-crm-five.vercel.app/api/linkedin/callback
# Or custom domain: https://crm.arfadevelopers.com/api/linkedin/callback# Optional — only after LinkedIn approves Community Management API:
# LINKEDIN_EXTRA_SCOPES=r_member_postAnalytics w_member_social_feed
LINKEDIN_API_VERSION=202601

AI_PROVIDER=auto
# Fallback order when AI_PROVIDER=auto (first available wins; failures try next)
AI_PROVIDER_ORDER=groq,gemini,kimi

# Primary: Groq (free) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback: Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash-lite

# Last resort: Kimi — https://platform.kimi.ai
# KIMI_API_KEY=your_kimi_api_key
# KIMI_API_BASE_URL=https://api.moonshot.ai/v1
# KIMI_MODEL=kimi-k2.5

IMAGE_GEN_PROVIDER=pollinations

OPENAI_API_KEY=
# Notion content pipeline (optional)
NOTION_API_KEY=
NOTION_DATABASE_ID=

# Google Sheets pipeline (optional)
GOOGLE_SHEETS_CREDENTIALS_PATH=./credentials/google-service-account.json
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_RANGE=Posts!A:D

# Job assistant profile
USER_FULL_NAME=
USER_EMAIL=aarfa.developers@gmail.com
USER_PHONE=
USER_LINKEDIN_URL=
USER_RESUME_PATH=./data/resume.txt
